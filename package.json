{
  "name": "goal-garden",
  "version": "0.1.0",
  "private": true,
  "description": "Goal Garden — offline-first goal planner by BambooTide",
  "author": "BambooTide",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:web": "next build",
    "build:demo": "cross-env NEXT_PUBLIC_DEMO_MODE=true next build",
    "start": "next start",
    "lint": "eslint",
    "desktop": "concurrently -k \"cross-env NEXT_PUBLIC_DESKTOP=true NEXT_PUBLIC_DEMO_MODE=true next dev -p 3000\" \"wait-on http://127.0.0.1:3000 && cross-env GOAL_GARDEN_DEV_URL=http://127.0.0.1:3000 electron .\"",
    "desktop:build": "cross-env NEXT_OUTPUT=standalone NEXT_PUBLIC_DESKTOP=true NEXT_PUBLIC_DEMO_MODE=true next build && node scripts/prepare-standalone.cjs && electron-builder --win",
    "desktop:dir": "cross-env NEXT_OUTPUT=standalone NEXT_PUBLIC_DESKTOP=true NEXT_PUBLIC_DEMO_MODE=true next build && node scripts/prepare-standalone.cjs && electron-builder --win --dir"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "openai": "^6.49.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "org.bambootide.goalgarden",
    "productName": "Goal Garden",
    "copyright": "Copyright © BambooTide",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "electron/assets"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "app/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "app/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "app/public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Goal-Garden-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Goal Garden"
    }
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "electron-winstaller@5.4.0": true
  }
}
